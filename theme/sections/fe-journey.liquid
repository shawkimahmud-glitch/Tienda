{%- liquid
  assign s = section.settings
  assign frames_m = s.frames_mobile
  if frames_m == blank
    assign frames_m = 'fe-seq-m.bin' | file_url
  endif
  assign frames_d = s.frames_desktop
  if frames_d == blank
    assign frames_d = 'fe-seq-d.bin' | file_url
  endif
-%}
{%- capture fe_price -%}{% render 'fe-price', product: s.product, fallback: s.price_fallback %}{%- endcapture -%}
{%- capture example -%}{"names":{{ s.example_names | json }},"phrase":{{ s.example_phrase | json }},"city":{{ s.example_city | json }},"date":{{ s.example_date | json }},"time":{{ s.example_time | json }},"style":"noche"}{%- endcapture -%}
<section class="fe-journey" data-fe-journey data-frames-m="{{ frames_m }}" data-frames-d="{{ frames_d }}" data-example="{{ example | escape }}" aria-label="{{ s.aria_label | escape }}">
  <div class="fe-journey__stage">
    <canvas class="fe-journey__seq" aria-hidden="true"></canvas>
    <div class="fe-journey__veil" aria-hidden="true"></div>
    <canvas class="fe-journey__gl" aria-hidden="true"></canvas>
    <div class="fe-journey__spark" aria-hidden="true"></div>
    <div class="fe-journey__poster"></div>

    <div class="fe-journey__copy">
      <div class="fe-beat fe-beat--first" data-beat data-in="0" data-out="0.085">
        <p class="fe-beat__line">{{ s.b1 | escape }}</p>
        <span class="fe-cue" aria-hidden="true">{{ s.cue | escape }}<i></i></span>
      </div>
      <div class="fe-beat fe-beat--low" data-beat data-in="0.15" data-out="0.26">
        <p class="fe-beat__line fe-split">{{ s.b2 | escape }}</p>
      </div>
      <div class="fe-beat fe-beat--low" data-beat data-in="0.29" data-out="0.43">
        <p class="fe-beat__sub fe-split" style="font-size:clamp(1.25rem,2.6vw,2rem);font-family:var(--fe-serif);color:var(--fe-ivory);max-width:24ch">{{ s.b3 | escape }}</p>
      </div>
      <div class="fe-beat fe-beat--low" data-beat data-in="0.45" data-out="0.53">
        <p class="fe-beat__line fe-split">{{ s.b4 | escape }}</p>
      </div>
      <div class="fe-beat fe-beat--top" data-beat data-in="0.53" data-out="0.67">
        <p class="fe-beat__line fe-split">{{ s.b5 | escape }}</p>
        <span class="fe-ticker" data-ticker aria-hidden="true"></span>
      </div>
      <div class="fe-beat fe-beat--low" data-beat data-in="0.7" data-out="0.84">
        <p class="fe-beat__line fe-split">{{ s.b6 | escape }}</p>
        <p class="fe-beat__sub">{{ s.b6_sub | escape }}</p>
      </div>
      <div class="fe-beat fe-beat--final" data-beat data-in="0.93" data-out="1.01">
        <h1 class="fe-display">{{ s.heading | escape }}</h1>
        <p>{{ s.text | escape }}</p>
        <div class="fe-beat__buy">
          <a class="fe-btn" href="#crea" data-magnetic><span class="fe-btn__label">{{ s.cta_label | escape }} · <span class="fe-btn__price">{{ s.price_prefix | escape }} {{ fe_price }}</span></span></a>
          <span class="fe-beat__note">{% render 'fe-icon', name: 'truck' %}{{ s.shipping | escape }}</span>
        </div>
      </div>
    </div>

    <a class="fe-journey__skip fe-link" href="#crea">{{ s.skip_label | escape }}</a>
    <div class="fe-journey__progress" aria-hidden="true"><i></i></div>
  </div>
</section>
{% schema %}
{
  "name": "FE · Viaje cósmico",
  "class": "fe-journey-section",
  "settings": [
    { "type": "header", "content": "Lámina de ejemplo" },
    { "type": "text", "id": "example_names", "label": "Nombres", "default": "Lucía & Daniel" },
    { "type": "text", "id": "example_phrase", "label": "Frase", "default": "La noche en que todo empezó" },
    { "type": "text", "id": "example_city", "label": "Ciudad", "default": "Madrid", "info": "Una de las ciudades de la lista del creador." },
    { "type": "text", "id": "example_date", "label": "Fecha (AAAA-MM-DD)", "default": "2021-05-14" },
    { "type": "text", "id": "example_time", "label": "Hora (HH:MM)", "default": "23:41" },
    { "type": "header", "content": "La película" },
    { "type": "text", "id": "b1", "label": "Escena 1 · Oscuridad", "default": "Todo empezó con una noche." },
    { "type": "text", "id": "cue", "label": "Indicación de scroll", "default": "Desliza" },
    { "type": "text", "id": "b2", "label": "Escena 2 · El sol", "default": "Antes de vosotros, hubo luz." },
    { "type": "textarea", "id": "b3", "label": "Escena 3 · El viaje", "default": "La luz de cada estrella viajó años, a veces siglos, para llegar a vuestra noche." },
    { "type": "text", "id": "b4", "label": "Escena 4 · La Tierra", "default": "Hasta un lugar." },
    { "type": "text", "id": "b5", "label": "Escena 4 · El momento", "default": "Un día. Una hora." },
    { "type": "text", "id": "b6", "label": "Escena 5 · La constelación", "default": "Y el cielo quedó escrito." },
    { "type": "textarea", "id": "b6_sub", "label": "Escena 5 · Texto", "default": "Calculamos la posición exacta de cada estrella sobre vuestra ciudad, a esa hora." },
    { "type": "header", "content": "La lámina" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "El cielo que os vio empezar." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Una lámina con el mapa estelar real de vuestra fecha y vuestro lugar." },
    { "type": "text", "id": "cta_label", "label": "Botón", "default": "Crea tu mapa" },
    { "type": "text", "id": "price_prefix", "label": "Texto antes del precio", "default": "desde" },
    { "type": "product", "id": "product", "label": "Producto (para el precio)" },
    { "type": "text", "id": "price_fallback", "label": "Precio si el producto no está publicado", "default": "39,95 €" },
    { "type": "text", "id": "shipping", "label": "Envío", "default": "Envío gratis a toda España" },
    { "type": "text", "id": "skip_label", "label": "Saltar introducción", "default": "Saltar la introducción" },
    { "type": "text", "id": "aria_label", "label": "Descripción accesible", "default": "Animación: del primer destello del sol al cielo de una noche concreta sobre Madrid, que se convierte en la lámina." },
    { "type": "header", "content": "Fotogramas", "info": "Por defecto se usan los archivos fe-seq-m.bin y fe-seq-d.bin de Contenido › Archivos." },
    { "type": "text", "id": "frames_mobile", "label": "URL fotogramas móvil" },
    { "type": "text", "id": "frames_desktop", "label": "URL fotogramas escritorio" }
  ],
  "presets": [{ "name": "FE · Viaje cósmico" }]
}
{% endschema %}
