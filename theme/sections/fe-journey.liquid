{%- liquid
  assign s = section.settings
  capture media
    render 'fe-media'
  endcapture
-%}
<section class="trip" data-trip data-media="{{ media }}" aria-label="{{ s.aria | escape }}">
  <div class="trip__stage">
    <canvas class="trip__film" aria-hidden="true"></canvas>
    <div class="trip__hero">
      {%- comment -%} The still star paints first (and stays when there is no WebGL or less motion is asked); the live one replaces it. {%- endcomment -%}
      <picture>
        <source media="(max-aspect-ratio: 4/5)" srcset="{{ media }}fe-hero-m.webp" width="780" height="1688">
        <img class="trip__poster" src="{{ media }}fe-hero-d.webp" width="1600" height="900" alt="{{ s.still_alt | escape }}" fetchpriority="high" decoding="async">
      </picture>
      <canvas class="trip__star" aria-hidden="true"></canvas>
    </div>
    <div class="trip__shade" aria-hidden="true"></div>
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      {%- if block.type == 'beat' -%}
        <div class="beat" data-beat data-from="{{ b.from }}" data-to="{{ b.to }}"{% if forloop.first %} data-on{% endif %}{% if b.still %} data-still{% endif %}{% if b.to > 100 %} data-final{% endif %} {{ block.shopify_attributes }}>
          <p class="hl"><span>{{ b.line1 | escape }}</span><em>{{ b.line2 | escape }}</em></p>
          {%- if b.title != blank or b.text != blank or b.button != blank -%}
            <div class="beat__aside">
              {%- if b.title != blank %}{% if forloop.first %}<h1>{{ b.title | escape }}</h1>{% else %}<p><strong>{{ b.title | escape }}</strong></p>{% endif %}{% endif -%}
              {%- if b.text != blank %}<p>{{ b.text | escape }}</p>{% endif -%}
              {%- if b.button != blank %}<a class="btn btn--lg" href="{{ b.link }}" data-magnetic>{{ b.button | escape }}{% render 'fe-icon', name: 'arrow' %}</a>{% endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="panel glass panel--{{ b.side }}" data-beat data-from="{{ b.from }}" data-to="{{ b.to }}" {{ block.shopify_attributes }}>
          <b>{{ b.title | escape }}</b><span>{{ b.text | escape }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
    <div class="trip__progress" aria-hidden="true"><i></i></div>
  </div>
</section>
{% schema %}
{
  "name": "FE · Viaje (estrella)",
  "settings": [
    { "type": "paragraph", "content": "Dos pantallas: la estrella dorada, el Sol, la Tierra y las constelaciones. Cada tramo aparece entre dos porcentajes del viaje (paradas en 0 %, 35 %, 67 % y 100 %)." },
    { "type": "text", "id": "aria", "label": "Descripción accesible", "default": "Una estrella dorada que se convierte en el Sol; después, la Tierra de noche y el cielo real sobre Madrid con sus constelaciones." },
    { "type": "text", "id": "still_alt", "label": "Texto alternativo de la estrella", "default": "Una estrella dorada y cristalina flotando entre estrellas." }
  ],
  "blocks": [
    { "type": "beat", "name": "Tramo", "settings": [
      { "type": "text", "id": "line1", "label": "Línea 1 (fina)", "default": "Hubo una noche" },
      { "type": "text", "id": "line2", "label": "Línea 2 (cursiva)", "default": "que lo cambió todo." },
      { "type": "range", "id": "from", "label": "Aparece en (% del viaje)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 0 },
      { "type": "range", "id": "to", "label": "Desaparece en (% del viaje)", "min": 1, "max": 101, "step": 1, "unit": "%", "default": 12 },
      { "type": "text", "id": "title", "label": "Texto lateral: título" },
      { "type": "textarea", "id": "text", "label": "Texto lateral: frase" },
      { "type": "text", "id": "button", "label": "Botón" },
      { "type": "text", "id": "link", "label": "Enlace del botón", "default": "#crea" },
      { "type": "checkbox", "id": "still", "label": "Mostrar en la versión sin movimiento", "default": false }
    ] },
    { "type": "panel", "name": "Panel de cristal", "settings": [
      { "type": "text", "id": "title", "label": "Línea 1", "default": "Fecha · Lugar · Hora" },
      { "type": "text", "id": "text", "label": "Línea 2", "default": "14/05/2021 · Madrid · 23:41" },
      { "type": "select", "id": "side", "label": "Posición", "options": [{ "value": "a", "label": "Arriba a la izquierda" }, { "value": "b", "label": "Abajo a la derecha" }], "default": "a" },
      { "type": "range", "id": "from", "label": "Aparece en (%)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 56 },
      { "type": "range", "id": "to", "label": "Desaparece en (%)", "min": 1, "max": 101, "step": 1, "unit": "%", "default": 80 }
    ] }
  ],
  "presets": [{ "name": "FE · Viaje (estrella)" }]
}
{% endschema %}
