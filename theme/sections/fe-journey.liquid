{%- liquid
  assign s = section.settings
  capture media
    render 'fe-media'
  endcapture
  assign frames_m = s.frames_mobile | default: media | append: ''
  if s.frames_mobile == blank
    assign frames_m = media | append: 'fe-seq-m.bin'
  endif
  if s.frames_desktop == blank
    assign frames_d = media | append: 'fe-seq-d.bin'
  else
    assign frames_d = s.frames_desktop
  endif
-%}
{%- capture example -%}{"names":{{ s.example_names | json }},"phrase":{{ s.example_phrase | json }},"city":{{ s.example_city | json }},"date":{{ s.example_date | json }},"time":{{ s.example_time | json }},"style":"noche"}{%- endcapture -%}
<section class="trip" data-trip data-frames-m="{{ frames_m }}" data-frames-d="{{ frames_d }}" data-media="{{ media }}" data-example="{{ example | escape }}" aria-label="{{ s.aria | escape }}">
  <div class="trip__stage">
    <canvas class="trip__film" aria-hidden="true"></canvas>
    <img class="trip__still" src="{{ media }}fe-still-d.webp" loading="lazy" width="1600" height="900" data-src-m="{{ media }}fe-still-m.webp" data-src-d="{{ media }}fe-still-d.webp" alt="{{ s.still_alt | escape }}" decoding="async">
    <div class="trip__point" aria-hidden="true"></div>
    <div class="trip__shade" aria-hidden="true"></div>
    <div class="lam" aria-hidden="true"><div class="lam__card"><div data-lam></div></div></div>
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      {%- if block.type == 'beat' -%}
        <div class="beat" data-beat data-from="{{ b.from }}" data-to="{{ b.to }}"{% if forloop.first %} data-on{% endif %}{% if b.still %} data-still{% endif %}{% if b.to > 100 %} data-final{% endif %} {{ block.shopify_attributes }}>
          <p class="hl"><span>{{ b.line1 | escape }}</span><em>{{ b.line2 | escape }}</em></p>
          {%- if b.title != blank or b.text != blank or b.button != blank -%}
            <div class="beat__aside">
              {%- if b.title != blank %}{% if forloop.first %}<h1>{{ b.title | escape }}</h1>{% else %}<p><strong>{{ b.title | escape }}</strong></p>{% endif %}{% endif -%}
              {%- if b.text != blank %}<p>{{ b.text | escape }}</p>{% endif -%}
              {%- if b.button != blank %}<a class="btn btn--lg" href="{{ b.link }}" data-magnetic>{{ b.button | escape }}{% render 'fe-icon', name: 'arrow' %}</a>{% endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="panel glass panel--{{ b.side }}" data-beat data-from="{{ b.from }}" data-to="{{ b.to }}" {{ block.shopify_attributes }}>
          <b>{{ b.title | escape }}</b><span>{{ b.text | escape }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
    <div class="trip__progress" aria-hidden="true"><i></i></div>
  </div>
</section>
{% schema %}
{
  "name": "FE · Túnel de estrellas",
  "settings": [
    { "type": "header", "content": "Lámina de ejemplo (la del final)" },
    { "type": "text", "id": "example_names", "label": "Nombres", "default": "Lucía & Daniel" },
    { "type": "text", "id": "example_phrase", "label": "Frase", "default": "La noche en que todo empezó" },
    { "type": "text", "id": "example_city", "label": "Ciudad", "default": "Madrid" },
    { "type": "text", "id": "example_date", "label": "Fecha (AAAA-MM-DD)", "default": "2021-05-14" },
    { "type": "text", "id": "example_time", "label": "Hora (HH:MM)", "default": "23:41" },
    { "type": "text", "id": "aria", "label": "Descripción accesible", "default": "Viaje desde un punto de luz, por un túnel de estrellas y junto al Sol, hasta el cielo real de una noche sobre Madrid, que se convierte en la lámina." },
    { "type": "text", "id": "still_alt", "label": "Texto alternativo del fotograma fijo", "default": "El cielo de Madrid la noche del 14 de mayo de 2021, con sus constelaciones unidas por líneas doradas." },
    { "type": "header", "content": "Película", "info": "Vacío = los archivos de la película del repositorio. Puedes pegar la URL de un archivo subido a Contenido › Archivos." },
    { "type": "text", "id": "frames_mobile", "label": "URL película móvil (.bin)" },
    { "type": "text", "id": "frames_desktop", "label": "URL película escritorio (.bin)" }
  ],
  "blocks": [
    { "type": "beat", "name": "Tramo", "settings": [
      { "type": "text", "id": "line1", "label": "Línea 1 (sans fina)", "default": "Hubo una noche" },
      { "type": "text", "id": "line2", "label": "Línea 2 (cursiva)", "default": "que lo cambió todo." },
      { "type": "range", "id": "from", "label": "Aparece en (% del viaje)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 0 },
      { "type": "range", "id": "to", "label": "Desaparece en (% del viaje)", "min": 1, "max": 101, "step": 1, "unit": "%", "default": 10 },
      { "type": "text", "id": "title", "label": "Texto lateral: título" },
      { "type": "textarea", "id": "text", "label": "Texto lateral: frase" },
      { "type": "text", "id": "button", "label": "Botón" },
      { "type": "text", "id": "link", "label": "Enlace del botón", "default": "#crea" },
      { "type": "checkbox", "id": "still", "label": "Mostrar en la versión sin movimiento", "default": false }
    ] },
    { "type": "panel", "name": "Panel de cristal", "settings": [
      { "type": "text", "id": "title", "label": "Línea 1", "default": "Fecha · Lugar · Hora" },
      { "type": "text", "id": "text", "label": "Línea 2", "default": "14.05.2021 · Madrid · 23:41" },
      { "type": "select", "id": "side", "label": "Posición", "options": [{ "value": "a", "label": "Arriba a la izquierda" }, { "value": "b", "label": "Abajo a la derecha" }], "default": "a" },
      { "type": "range", "id": "from", "label": "Aparece en (%)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 62 },
      { "type": "range", "id": "to", "label": "Desaparece en (%)", "min": 1, "max": 101, "step": 1, "unit": "%", "default": 73 }
    ] }
  ],
  "presets": [{ "name": "FE · Túnel de estrellas" }]
}
{% endschema %}
