<section id="preguntas" class="sec" aria-labelledby="h-{{ section.id }}">
  <div class="wrap faq">
    <div>
      <h2 id="h-{{ section.id }}" class="hl hl--md" data-reveal><span>{{ section.settings.line1 | escape }}</span><em>{{ section.settings.line2 | escape }}</em></h2>
      <p class="lede" style="margin-top:22px">{{ section.settings.text | escape }}</p>
    </div>
    <div>
      {%- for block in section.blocks -%}
        <details class="qa" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.q | escape }}<i aria-hidden="true"></i></summary>
          <div class="qa__a">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FE · Preguntas",
  "settings": [
    { "type": "text", "id": "line1", "label": "Titular línea 1", "default": "Lo que" },
    { "type": "text", "id": "line2", "label": "Titular línea 2 (cursiva)", "default": "nos preguntáis." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "¿Otra duda? Escríbenos a [EMAIL DE CONTACTO]." }
  ],
  "blocks": [{ "type": "qa", "name": "Pregunta", "limit": 5, "settings": [
    { "type": "text", "id": "q", "label": "Pregunta", "default": "¿El cielo es real?" },
    { "type": "richtext", "id": "a", "label": "Respuesta", "default": "<p>Sí.</p>" }
  ] }],
  "presets": [{ "name": "FE · Preguntas" }]
}
{% endschema %}
