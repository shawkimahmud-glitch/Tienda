{%- liquid
  assign s = section.settings
  assign p = s.product
  if p == blank
    assign p = all_products['mapa-estelar-personalizado-el-cielo-de-vuestra-noche']
  endif
  assign dv = nil
  assign key = s.match | downcase
  if p != blank
    for v in p.variants
      assign vt = v.title | downcase
      if vt contains key
        assign dv = v
        break
      endif
    endfor
  endif
  assign in_cart = false
  if dv
    for item in cart.items
      if item.variant_id == dv.id
        assign in_cart = true
      endif
    endfor
  endif
-%}
{%- if dv and cart.item_count > 0 and in_cart == false -%}
  <div class="page-width" style="margin-block:24px">
    <form action="{{ routes.cart_add_url }}" method="post" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px;padding:18px 22px;border-radius:16px;border:1px solid rgba(var(--color-foreground-rgb, 0 0 0) / 0.12)">
      <input type="hidden" name="id" value="{{ dv.id }}">
      <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
      <p style="margin:0">{{ s.text | escape }}</p>
      <button type="submit" class="button">{{ s.button | escape }}</button>
    </form>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width" style="margin-block:24px;opacity:.7"><p>FE · Venta extra: aparece cuando hay productos en la cesta y existe una variante cuyo nombre contiene «{{ s.match }}».</p></div>
{%- endif -%}
{% schema %}
{
  "name": "FE · Venta extra digital",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "text", "id": "match", "label": "Palabra de la variante", "default": "Digital" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Añade también el archivo digital por 9,99 €." },
    { "type": "text", "id": "button", "label": "Botón", "default": "Añadir" }
  ],
  "presets": [{ "name": "FE · Venta extra digital" }]
}
{% endschema %}
