{%- liquid
  assign s = section.settings
  assign has_app = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app = true
    endif
  endfor
-%}
<section id="crea" class="sec" data-creator aria-labelledby="h-{{ section.id }}">
  <div class="wrap">
    <div class="make">
      <div class="make__view glass" data-reveal>
        <div class="make__poster"><div data-preview role="img" aria-label="Vista previa de vuestra lámina"></div></div>
      </div>
      <div>
        <h2 id="h-{{ section.id }}" class="hl hl--md" data-reveal><span>{{ s.line1 | escape }}</span><em>{{ s.line2 | escape }}</em></h2>
        <p class="lede make__lede">{{ s.text | escape }}</p>
        {%- if has_app -%}
          {%- for block in section.blocks -%}{%- if block.type == '@app' %}{% render block %}{% endif -%}{%- endfor -%}
        {%- else -%}
          {%- comment -%} Customall: add its app block to this section (Personalizar › FE · Creador › Añadir bloque). It replaces this live mock. {%- endcomment -%}
          <form class="form" data-form novalidate>
            <label class="field"><span>{{ s.l_names | escape }}</span><input class="input" name="names" value="{{ s.d_names | escape }}" maxlength="40" autocomplete="off"></label>
            <label class="field"><span>{{ s.l_phrase | escape }}</span><input class="input" name="phrase" value="{{ s.d_phrase | escape }}" maxlength="60" autocomplete="off"></label>
            <label class="field"><span>{{ s.l_city | escape }}</span><select class="input" name="city"><option selected>{{ s.d_city | escape }}</option></select></label>
            <div class="row2">
              <label class="field"><span>{{ s.l_date | escape }}</span><input class="input" type="date" name="date" value="{{ s.d_date }}" min="1900-01-01" max="2100-12-31"></label>
              <label class="field"><span>{{ s.l_time | escape }}</span><input class="input" type="time" name="time" value="{{ s.d_time }}"></label>
            </div>
            <fieldset class="make__set">
              <legend class="note make__legend">{{ s.l_style | escape }}</legend>
              <div class="seg glass"><label><input type="radio" name="style" value="noche" checked>Noche</label><label><input type="radio" name="style" value="marfil">Marfil</label></div>
            </fieldset>
            <p class="note" data-coords></p>
            <div class="make__go"><a class="btn btn--lg" href="#formatos" data-magnetic>{{ s.button | escape }}{% render 'fe-icon', name: 'arrow' %}</a></div>
          </form>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FE · Creador",
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "text", "id": "line1", "label": "Titular línea 1", "default": "Vuestra lámina," },
    { "type": "text", "id": "line2", "label": "Titular línea 2 (cursiva)", "default": "con vuestro cielo." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Escribid vuestros nombres, el lugar y la fecha. La lámina se dibuja al momento con las estrellas que había esa noche." },
    { "type": "text", "id": "l_names", "label": "Etiqueta nombres", "default": "Nombres" },
    { "type": "text", "id": "d_names", "label": "Nombres por defecto", "default": "Lucía & Daniel" },
    { "type": "text", "id": "l_phrase", "label": "Etiqueta frase", "default": "Una frase" },
    { "type": "text", "id": "d_phrase", "label": "Frase por defecto", "default": "La noche en que todo empezó" },
    { "type": "text", "id": "l_city", "label": "Etiqueta lugar", "default": "Lugar" },
    { "type": "text", "id": "d_city", "label": "Lugar por defecto", "default": "Madrid" },
    { "type": "text", "id": "l_date", "label": "Etiqueta fecha", "default": "Fecha" },
    { "type": "text", "id": "d_date", "label": "Fecha por defecto (AAAA-MM-DD)", "default": "2021-05-14" },
    { "type": "text", "id": "l_time", "label": "Etiqueta hora", "default": "Hora" },
    { "type": "text", "id": "d_time", "label": "Hora por defecto", "default": "23:41" },
    { "type": "text", "id": "l_style", "label": "Etiqueta estilo", "default": "Estilo" },
    { "type": "text", "id": "button", "label": "Botón", "default": "Elegir formato" }
  ],
  "presets": [{ "name": "FE · Creador" }]
}
{% endschema %}
