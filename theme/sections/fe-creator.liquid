{%- liquid
  assign s = section.settings
  assign p = s.product
  if p == blank
    assign p = all_products['mapa-estelar-personalizado-el-cielo-de-vuestra-noche']
  endif
  assign base_url = '/products/mapa-estelar-personalizado-el-cielo-de-vuestra-noche'
  if p != blank
    assign base_url = p.url
  endif
  assign has_app = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app = true
    endif
  endfor
-%}
<section id="crea" class="fe-sec fe-sec--night fe-creator" data-fe-creator aria-labelledby="fe-creator-{{ section.id }}">
  <div class="fe-wrap">
    <div class="fe-creator__grid">
      {%- if has_app -%}
        <div>
          <h2 id="fe-creator-{{ section.id }}" class="fe-h2">{{ s.heading | escape }}</h2>
          <p class="fe-lede">{{ s.text | escape }}</p>
        </div>
        <div>
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' %}{% render block %}{% endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        {%- comment -%}
          Customall: add its app block to this section in the theme editor (Personalizar › FE · Creador › Añadir bloque).
          When an app block is present, this mock (preview + form) is replaced by it.
        {%- endcomment -%}
        <div class="fe-creator__stage">
          <div class="fe-creator__frame"><div data-preview role="img" aria-label="Vista previa de la lámina"></div></div>
        </div>
        <div>
          <h2 id="fe-creator-{{ section.id }}" class="fe-h2" data-reveal="words">{{ s.heading | escape }}</h2>
          <p class="fe-lede" style="margin-bottom:40px">{{ s.text | escape }}</p>
          <form class="fe-form" action="{{ base_url }}" method="get" novalidate>
            <label class="fe-field"><span>{{ s.label_names | escape }}</span>
              <input class="fe-input" name="names" value="{{ s.default_names | escape }}" maxlength="40" autocomplete="off" placeholder="{{ s.default_names | escape }}">
            </label>
            <label class="fe-field"><span>{{ s.label_phrase | escape }}</span>
              <input class="fe-input" name="phrase" value="{{ s.default_phrase | escape }}" maxlength="60" autocomplete="off">
            </label>
            <label class="fe-field"><span>{{ s.label_city | escape }}</span>
              <select class="fe-input" name="city"><option selected>{{ s.default_city | escape }}</option></select>
            </label>
            <div class="fe-row">
              <label class="fe-field"><span>{{ s.label_date | escape }}</span>
                <input class="fe-input" type="date" name="date" value="{{ s.default_date }}" min="1900-01-01" max="2100-12-31" required>
              </label>
              <label class="fe-field"><span>{{ s.label_time | escape }}</span>
                <input class="fe-input" type="time" name="time" value="{{ s.default_time }}">
              </label>
            </div>
            <p class="fe-creator__note" style="margin-top:-14px" data-coords></p>
            <fieldset class="fe-choices" style="gap:12px">
              <legend class="fe-legend">{{ s.label_style | escape }}</legend>
              <div class="fe-seg">
                <label><input type="radio" name="style" value="noche" checked>Noche</label>
                <label><input type="radio" name="style" value="marfil">Marfil</label>
              </div>
            </fieldset>
            <fieldset class="fe-choices">
              <legend class="fe-legend">{{ s.label_format | escape }}</legend>
              {%- if p != blank and p.variants.size > 0 -%}
                {%- assign sorted = p.variants | sort: 'price' -%}
                {%- for v in sorted -%}
                  {%- assign vt = v.title | downcase -%}
                  <label class="fe-choice">
                    <input type="radio" name="variant" value="{{ v.id }}" data-price="{{ v.price | money }}"{% if vt contains 'marco' %} data-frame="1"{% endif %}{% if forloop.first %} checked{% endif %}{% unless v.available %} disabled{% endunless %}>
                    <span class="fe-choice__t"><b>{{ v.title | escape }}</b>{% unless v.available %}<small>Agotado</small>{% endunless %}</span>
                    <span class="fe-choice__p">{{ v.price | money }}</span>
                  </label>
                {%- endfor -%}
              {%- else -%}
                <label class="fe-choice"><input type="radio" name="variant" value="" data-price="39,95 €" checked><span class="fe-choice__t"><b>Lámina A4 · 21×30 cm</b></span><span class="fe-choice__p">39,95 €</span></label>
                <label class="fe-choice"><input type="radio" name="variant" value="" data-price="44,95 €"><span class="fe-choice__t"><b>Lámina 30×40 cm</b></span><span class="fe-choice__p">44,95 €</span></label>
                <label class="fe-choice"><input type="radio" name="variant" value="" data-price="79,95 €" data-frame="1"><span class="fe-choice__t"><b>30×40 cm con marco de roble</b></span><span class="fe-choice__p">79,95 €</span></label>
              {%- endif -%}
            </fieldset>
            <div class="fe-total"><span class="fe-meta">{{ s.label_total | escape }}</span><strong data-price>{% if p != blank %}{{ p.price_min | money }}{% else %}39,95 €{% endif %}</strong></div>
            <a class="fe-btn" href="{{ base_url }}" data-cta data-base="{{ base_url }}" data-magnetic><span class="fe-btn__label">{{ s.button | escape }}</span></a>
            <ul class="fe-assure">
              <li>{% render 'fe-icon', name: 'truck' %}{{ s.assure_1 | escape }}</li>
              <li>{% render 'fe-icon', name: 'user' %}{{ s.assure_2 | escape }}</li>
              <li>{% render 'fe-icon', name: 'eye' %}{{ s.assure_3 | escape }}</li>
            </ul>
            <p class="fe-creator__note">{{ s.note | escape }}</p>
          </form>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FE · Creador",
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Diseñad vuestro cielo" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Escribid vuestros nombres, el lugar y la fecha. La lámina se dibuja al momento, con las estrellas reales de esa noche." },
    { "type": "text", "id": "label_names", "label": "Etiqueta nombres", "default": "Nombres" },
    { "type": "text", "id": "default_names", "label": "Nombres por defecto", "default": "Lucía & Daniel" },
    { "type": "text", "id": "label_phrase", "label": "Etiqueta frase", "default": "Vuestra frase" },
    { "type": "text", "id": "default_phrase", "label": "Frase por defecto", "default": "La noche en que todo empezó" },
    { "type": "text", "id": "label_city", "label": "Etiqueta ciudad", "default": "Ciudad" },
    { "type": "text", "id": "default_city", "label": "Ciudad por defecto", "default": "Madrid" },
    { "type": "text", "id": "label_date", "label": "Etiqueta fecha", "default": "Fecha" },
    { "type": "text", "id": "default_date", "label": "Fecha por defecto (AAAA-MM-DD)", "default": "2021-05-14" },
    { "type": "text", "id": "label_time", "label": "Etiqueta hora", "default": "Hora" },
    { "type": "text", "id": "default_time", "label": "Hora por defecto", "default": "23:41" },
    { "type": "text", "id": "label_style", "label": "Etiqueta estilo", "default": "Estilo" },
    { "type": "text", "id": "label_format", "label": "Etiqueta formato", "default": "Formato" },
    { "type": "text", "id": "label_total", "label": "Etiqueta total", "default": "Total" },
    { "type": "text", "id": "button", "label": "Botón", "default": "Continuar con este diseño" },
    { "type": "text", "id": "assure_1", "label": "Garantía 1", "default": "Envío gratis a toda España" },
    { "type": "text", "id": "assure_2", "label": "Garantía 2", "default": "Sin crear cuenta" },
    { "type": "text", "id": "assure_3", "label": "Garantía 3", "default": "La veis antes de pagar" },
    { "type": "textarea", "id": "note", "label": "Nota", "default": "Vista previa orientativa. En el siguiente paso confirmáis el texto definitivo antes de pagar." }
  ],
  "presets": [{ "name": "FE · Creador" }]
}
{% endschema %}
