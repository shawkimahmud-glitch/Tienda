<section class="fe-finale" aria-labelledby="fe-finale-{{ section.id }}">
  <canvas data-fe-trails aria-hidden="true"></canvas>
  <div class="fe-wrap fe-finale__inner">
    <h2 id="fe-finale-{{ section.id }}" class="fe-display" data-reveal="words">{{ section.settings.heading | escape }}</h2>
    <p data-reveal>{{ section.settings.text | escape }}</p>
    <a class="fe-btn" href="{{ section.settings.link | default: '#crea' }}" data-magnetic data-reveal><span class="fe-btn__label">{{ section.settings.cta | escape }}</span></a>
  </div>
</section>
{% schema %}
{
  "name": "FE · Cierre",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titular", "default": "Esa noche ya pasó. Su cielo puede quedarse." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Elegid la fecha. Nosotros ponemos las estrellas en su sitio." },
    { "type": "text", "id": "cta", "label": "Botón", "default": "Crear nuestro mapa" },
    { "type": "text", "id": "link", "label": "Enlace", "default": "#crea" }
  ],
  "presets": [{ "name": "FE · Cierre" }]
}
{% endschema %}
