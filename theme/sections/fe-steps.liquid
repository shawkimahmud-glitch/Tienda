<section class="fe-sec" aria-labelledby="fe-steps-{{ section.id }}">
  <div class="fe-wrap">
    <h2 id="fe-steps-{{ section.id }}" class="fe-h2" data-reveal="words" style="max-width:16ch;margin-bottom:clamp(40px,7vh,80px)">{{ section.settings.heading | escape }}</h2>
    <ol class="fe-steps">
      {%- for block in section.blocks -%}
        <li class="fe-step" data-reveal style="transition-delay: {{ forloop.index0 | times: 90 }}ms" {{ block.shopify_attributes }}>
          <span class="fe-step__n">{% render 'fe-icon', name: block.settings.icon %}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{% schema %}
{
  "name": "FE · Cómo funciona",
  "settings": [{ "type": "text", "id": "heading", "label": "Titular", "default": "De una fecha a vuestra pared" }],
  "blocks": [{
    "type": "step", "name": "Paso",
    "settings": [
      { "type": "select", "id": "icon", "label": "Icono", "options": [{ "value": "date", "label": "Fecha" }, { "value": "pen", "label": "Pluma" }, { "value": "home", "label": "Casa" }], "default": "date" },
      { "type": "text", "id": "title", "label": "Título", "default": "Elegid el instante" },
      { "type": "textarea", "id": "text", "label": "Texto", "default": "Fecha, hora y lugar." }
    ]
  }],
  "presets": [{
    "name": "FE · Cómo funciona",
    "blocks": [
      { "type": "step", "settings": { "icon": "date", "title": "Elegid el instante", "text": "La fecha, la hora y la ciudad. Con eso calculamos qué estrellas había sobre vosotros." } },
      { "type": "step", "settings": { "icon": "pen", "title": "Escribid vuestras palabras", "text": "Vuestros nombres y una frase. Veis la lámina cambiar mientras escribís." } },
      { "type": "step", "settings": { "icon": "home", "title": "Llega a vuestra casa", "text": "La imprimimos y os la enviamos sin coste a toda España. Plazo de entrega: [PLAZO DE ENTREGA]." } }
    ]
  }]
}
{% endschema %}
