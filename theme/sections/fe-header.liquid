{%- assign s = section.settings -%}
<style>:root { --blue: {{ s.blue }}; }</style>
<header class="head">
  <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}, inicio">{% render 'fe-icon', name: 'star' %}<i>{{ s.logo_a | escape }}</i><b>{{ s.logo_b | escape }}</b></a>
  <div class="head__end">
    <nav class="pills glass" aria-label="Principal">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
      {%- endfor -%}
    </nav>
    <p class="head__price">{{ s.price_prefix | escape }} <b>{{ s.price | escape }}</b></p>
    <a class="btn" href="{{ s.cta_link }}" data-magnetic>{{ s.cta | escape }}{% render 'fe-icon', name: 'arrow' %}</a>
    <a class="cart glass" href="{{ routes.cart_url }}" aria-label="Cesta, {{ cart.item_count }} {% if cart.item_count == 1 %}artículo{% else %}artículos{% endif %}">
      {%- render 'fe-icon', name: 'cart' -%}
      {%- if cart.item_count > 0 %}<span class="cart__n" aria-hidden="true">{{ cart.item_count }}</span>{% endif -%}
    </a>
  </div>
</header>
<div class="bar glass" role="region" aria-label="Comprar">
  <p><strong>{{ s.price_prefix | escape }} {{ s.price | escape }}</strong><span>{{ s.bar_note | escape }}</span></p>
  <a class="btn" href="{{ s.cta_link }}">{{ s.cta | escape }}{% render 'fe-icon', name: 'arrow' %}</a>
</div>
{% schema %}
{
  "name": "FE · Cabecera",
  "settings": [
    { "type": "text", "id": "logo_a", "label": "Logo (cursiva)", "default": "Fecha" },
    { "type": "text", "id": "logo_b", "label": "Logo (recta)", "default": "Estelar" },
    { "type": "text", "id": "price_prefix", "label": "Texto antes del precio", "default": "Desde" },
    { "type": "text", "id": "price", "label": "Precio más bajo", "default": "4,95 €" },
    { "type": "text", "id": "bar_note", "label": "Nota de la barra móvil", "default": "Envío gratis · 4–8 días" },
    { "type": "text", "id": "cta", "label": "Botón", "default": "Crear mi lámina" },
    { "type": "text", "id": "cta_link", "label": "Enlace del botón", "default": "#crea" },
    { "type": "color", "id": "blue", "label": "Color del botón", "default": "#A9C2EE" }
  ],
  "blocks": [{ "type": "link", "name": "Píldora", "limit": 4, "settings": [
    { "type": "text", "id": "label", "label": "Texto", "default": "Diseñar" },
    { "type": "text", "id": "link", "label": "Enlace", "default": "#crea" }
  ] }],
  "default": { "blocks": [
    { "type": "link", "settings": { "label": "Diseñar", "link": "#crea" } },
    { "type": "link", "settings": { "label": "Formatos", "link": "#formatos" } },
    { "type": "link", "settings": { "label": "Preguntas", "link": "#preguntas" } }
  ] }
}
{% endschema %}
