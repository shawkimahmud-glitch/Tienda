<section class="fe-ribbon" aria-label="{{ section.settings.label | escape }}" style="--speed: {{ section.settings.speed }}s">
  <div class="fe-ribbon__track">
    {%- for i in (1..2) -%}
      <ul class="fe-ribbon__set" role="list" {% if i == 2 %}aria-hidden="true"{% endif %} style="list-style:none;margin:0;padding:0">
        {%- for block in section.blocks -%}
          <li class="fe-ribbon__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}{% render 'fe-icon', name: 'star' %}</li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "FE · Ocasiones",
  "settings": [
    { "type": "text", "id": "label", "label": "Descripción accesible", "default": "Ocasiones" },
    { "type": "range", "id": "speed", "label": "Duración de una vuelta", "min": 20, "max": 90, "step": 2, "unit": "s", "default": 46 }
  ],
  "blocks": [{ "type": "item", "name": "Ocasión", "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "Aniversarios" }] }],
  "presets": [{
    "name": "FE · Ocasiones",
    "blocks": [
      { "type": "item", "settings": { "text": "Aniversarios" } },
      { "type": "item", "settings": { "text": "Bodas" } },
      { "type": "item", "settings": { "text": "Nacimientos" } },
      { "type": "item", "settings": { "text": "San Valentín" } },
      { "type": "item", "settings": { "text": "Navidad" } },
      { "type": "item", "settings": { "text": "Pedidas de mano" } },
      { "type": "item", "settings": { "text": "La primera cita" } },
      { "type": "item", "settings": { "text": "Para recordar a alguien" } }
    ]
  }]
}
{% endschema %}
