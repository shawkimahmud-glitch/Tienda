<footer class="foot">
  <div class="wrap">
    <div class="foot__top">
      <div>
        <a class="logo" href="{{ routes.root_url }}">{% render 'fe-icon', name: 'star' %}<i>Fecha</i><b>Estelar</b></a>
        <p class="foot__claim">{{ section.settings.claim | escape }}</p>
      </div>
      <nav aria-labelledby="f1-{{ section.id }}"><h2 id="f1-{{ section.id }}">{{ section.settings.menu_title | escape }}</h2>
        <ul>
          {%- if section.settings.menu != blank -%}
            {%- for link in section.settings.menu.links -%}<li><a class="link" href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
          {%- else -%}
            <li><a class="link" href="{{ routes.root_url }}#crea">Crear mi lámina</a></li>
            <li><a class="link" href="{{ routes.root_url }}#formatos">Formatos y precios</a></li>
            <li><a class="link" href="{{ routes.cart_url }}">Cesta</a></li>
          {%- endif -%}
        </ul>
      </nav>
      <nav aria-labelledby="f2-{{ section.id }}"><h2 id="f2-{{ section.id }}">{{ section.settings.legal_title | escape }}</h2>
        <ul>
          {%- for policy in shop.policies -%}<li><a class="link" href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endfor -%}
          <li><span>{{ section.settings.contact | escape }}</span></li>
        </ul>
      </nav>
    </div>
    <div class="foot__legal">
      <p>© {{ 'now' | date: '%Y' }} {{ section.settings.company | escape }} · NIF {{ section.settings.tax_id | escape }}</p>
      <p>{{ section.settings.credits | escape }}</p>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "FE · Pie",
  "settings": [
    { "type": "text", "id": "claim", "label": "Frase", "default": "Para las noches que no queréis olvidar." },
    { "type": "text", "id": "menu_title", "label": "Título menú", "default": "Tienda" },
    { "type": "link_list", "id": "menu", "label": "Menú" },
    { "type": "text", "id": "legal_title", "label": "Título legal", "default": "Legal y contacto" },
    { "type": "text", "id": "contact", "label": "Contacto", "default": "[EMAIL DE CONTACTO]" },
    { "type": "text", "id": "company", "label": "Razón social", "default": "SHAWKI SERVICIOS PROFESIONALES, S.L." },
    { "type": "text", "id": "tax_id", "label": "NIF", "default": "B93906600" },
    { "type": "text", "id": "credits", "label": "Créditos", "default": "Estrellas: d3-celestial (BSD) · Tierra: NASA Blue Marble y Black Marble · Ciudades: GeoNames (CC BY 4.0)" }
  ]
}
{% endschema %}
