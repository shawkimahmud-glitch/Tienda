{%- assign s = section.settings -%}
<section class="fe-sec fe-instant" data-fe-instant aria-labelledby="fe-instant-{{ section.id }}">
  <div class="fe-wrap">
    <h2 id="fe-instant-{{ section.id }}" class="fe-sr">{{ s.heading | escape }}</h2>
    <p class="fe-instant__date"><span data-roll>{{ s.day }}</span><span class="fe-dot" aria-hidden="true">·</span><span data-roll>{{ s.month }}</span><span class="fe-dot" aria-hidden="true">·</span><span data-roll>{{ s.year }}</span></p>
    <div class="fe-instant__grid">
      <p class="fe-instant__body" data-reveal="words">{{ s.body | escape }}</p>
      <dl class="fe-instant__facts" data-reveal>
        <div><dt>{{ s.time_label | escape }}</dt><dd>{{ s.time | escape }}</dd></div>
        <div><dt>{{ s.place_label | escape }}</dt><dd>{{ s.place | escape }}</dd></div>
        <div><dt>{{ s.coords_label | escape }}</dt><dd>{{ s.coords | escape }}</dd></div>
        <div><dt>{{ s.stars_label | escape }}</dt><dd>{{ s.stars | escape }}</dd></div>
      </dl>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FE · El instante",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (accesible)", "default": "El instante" },
    { "type": "text", "id": "day", "label": "Día", "default": "14" },
    { "type": "text", "id": "month", "label": "Mes", "default": "05" },
    { "type": "text", "id": "year", "label": "Año", "default": "2021" },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Una fecha es solo un número hasta que alguien la convierte en vuestra. Esa noche, sobre Madrid, el cielo estaba exactamente así." },
    { "type": "text", "id": "time_label", "label": "Etiqueta hora", "default": "Hora" },
    { "type": "text", "id": "time", "label": "Hora", "default": "23:41 h" },
    { "type": "text", "id": "place_label", "label": "Etiqueta lugar", "default": "Lugar" },
    { "type": "text", "id": "place", "label": "Lugar", "default": "Madrid, España" },
    { "type": "text", "id": "coords_label", "label": "Etiqueta coordenadas", "default": "Coordenadas" },
    { "type": "text", "id": "coords", "label": "Coordenadas", "default": "40°25′N · 3°42′O" },
    { "type": "text", "id": "stars_label", "label": "Etiqueta estrellas", "default": "Cielo" },
    { "type": "text", "id": "stars", "label": "Dato del cielo", "default": "Calculado, no inventado" }
  ],
  "presets": [{ "name": "FE · El instante" }]
}
{% endschema %}
