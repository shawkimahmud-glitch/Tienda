{%- assign s = section.settings -%}
<section class="sec" aria-labelledby="h-{{ section.id }}">
  <div class="wrap">
    <div class="promise glass" data-reveal>
      {% render 'fe-icon', name: 'shield' %}
      <h2 id="h-{{ section.id }}" class="hl hl--md"><span>{{ s.line1 | escape }}</span><em>{{ s.line2 | escape }}</em></h2>
      <p class="lede promise__text">{{ s.text | escape }}</p>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FE · Garantía",
  "settings": [
    { "type": "text", "id": "line1", "label": "Titular línea 1", "default": "Si llega dañada o con un error nuestro," },
    { "type": "text", "id": "line2", "label": "Titular línea 2 (cursiva)", "default": "te enviamos otra gratis." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Escríbenos a [EMAIL DE CONTACTO] con una foto y la reponemos sin coste." }
  ],
  "presets": [{ "name": "FE · Garantía" }]
}
{% endschema %}
