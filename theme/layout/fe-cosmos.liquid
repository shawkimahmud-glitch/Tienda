<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#05070D">
    <title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
    {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_url }}">
    {%- if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
    {%- if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% endif %}
    <script>
      (function (d) {
        var r = d.documentElement;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) r.classList.add('fe-js');
        setTimeout(function () { if (!window.__feBoot) r.classList.remove('fe-js'); }, 7000);
      })(document);
    </script>
    <script nomodule>document.documentElement.classList.remove('fe-js');</script>
    {%- liquid
      assign serif = settings.type_heading_font
      assign sans = settings.type_body_font
      assign serif_400 = serif | font_modify: 'weight', '400'
      assign serif_500 = serif | font_modify: 'weight', '500'
      assign serif_i = serif_400 | font_modify: 'style', 'italic'
      assign sans_400 = sans | font_modify: 'weight', '400'
      assign sans_500 = sans | font_modify: 'weight', '500'
      assign sans_600 = sans | font_modify: 'weight', '600'
      assign sans_700 = sans | font_modify: 'weight', '700'
    -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- if serif_400 %}<link rel="preload" as="font" href="{{ serif_400 | font_url }}" type="font/woff2" crossorigin>{% endif %}
    <style>
      {{ serif_400 | font_face: font_display: 'swap' }}
      {{ serif_500 | font_face: font_display: 'swap' }}
      {{ serif_i | font_face: font_display: 'swap' }}
      {{ sans_400 | font_face: font_display: 'swap' }}
      {{ sans_500 | font_face: font_display: 'swap' }}
      {{ sans_600 | font_face: font_display: 'swap' }}
      {{ sans_700 | font_face: font_display: 'swap' }}
    </style>
    {{ 'fe.css' | asset_url | stylesheet_tag }}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.min.js","gsap":"https://cdn.jsdelivr.net/npm/gsap@3.12.5/+esm","gsap/ScrollTrigger":"https://cdn.jsdelivr.net/npm/gsap@3.12.5/ScrollTrigger.js/+esm","lenis":"https://cdn.jsdelivr.net/npm/lenis@1.1.13/+esm"}}</script>
    <link rel="modulepreload" href="{{ 'fe-app.js' | asset_url }}">
    <script type="module" src="{{ 'fe-app.js' | asset_url }}"></script>
    {{ content_for_header }}
  </head>
  <body class="fe-body">
    <a class="fe-skip" href="#fe-main">Saltar al contenido</a>
    {% section 'fe-header' %}
    <main id="fe-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% section 'fe-footer' %}
  </body>
</html>
